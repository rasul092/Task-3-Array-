#include <iostream>
using namespace std;

void print(){ // Massivdə ilk və son sıfıra bərabər elementlər arasındakı məsafəni tapan funksiya 
    int array[]={5,3,2,1,0,4,5,0};
    int n=sizeof(array)/sizeof(array[0]);
    int lastZero=-1;
    int firstZero =-1;
    
    for (int i=0; i<n; i++){
        if(array[i]==0){
            firstZero =i;
            break;
            
        }
    }
    for (int i=n-1;i>=0;i--){
        if(array[i]==0){
            lastZero=i;
            break;
        }
    }
    
    if(lastZero == -1 || firstZero == -1  ) {
        cout<<"massivde sifir yoxdur : ";
    }
    else {
        cout<<"sifirlar arasinda mesafe : "<<lastZero-firstZero;
    }
}
 
 int main(){
     print();
     return 0;
 }
