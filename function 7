// Online C++ compiler to run C++ program online
#include <iostream>
using namespace std;

void print (){
    int array1[]={30,25,61,42,56,78,83,40};
    int array2[]={102,108,110,190,200,170,130};   //suni intellekden komek alanda n-2 falan nese dedi orasini basa dusmedim deye n-2 falan yazmadan tamamladim kodu
    int n=sizeof(array1)/sizeof(array1[0]);       //bele yoxladim kodda sehv tapa bilmedim
    int m=sizeof(array2)/sizeof(array2[0]);
    int k;
    cout<<"k ededini daxil edin : ";
    cin>>k;
    int yeniUzunluq=m+n;
    int array3[yeniUzunluq];
    int idx=0;
    
    for(int i=0;i<=k;i++){
        array3[idx++]=array1[i];
    }
    
    for(int i=0;i<m;i++){
        array3[idx++]=array2[i];
    }
    
    for(int i=k+1;i<n;i++){
        array3[idx++]=array1[i];
    }
    
    cout<<"yeni massivdeki ededler : ";
    for(int i=0;i<yeniUzunluq;i++){
        cout<<array3[i]<<" ";
    }
    cout<<endl;
}
    
    int main(){
        print();
        return 0;
    }

