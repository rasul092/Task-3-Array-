#include <iostream>
#include <cmath>
using namespace std;

void print(){ // 20 elementdən ibarət massiv verilmişdir. Bu massivin ilk yarısının ədədi ortasını, növbəti yarısının həndəsi ortasını tapan funksiya
int array[]={2,3,4,5,6,2,1,3,5,6,7,8,9,0,4,3,8,9,1};
    int n=sizeof(array)/sizeof(array[0]);
    int sum =0;
    
    for(int i=0;i<n/2;i++){
        sum+=array[i];
    }
    double edediOrta =(double) sum/(n/2);
    int product=1;
    for (int i=n/2;i<n;i++){
        product*=array[i];
    }
    double hendesiOrta=pow(product,1.0/(n/2));
    
    cout<<"Ilk yarinin ededi ortasi : "<<edediOrta<<" "<<endl;
    cout<<"son yarinin hendesi ortasi : "<< hendesiOrta<<endl;
}
int main(){
    print();
    return 0;
    
}
